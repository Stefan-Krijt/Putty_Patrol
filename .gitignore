# Windows OS generated files
Thumbs.db
desktop.ini
*.tmp
*.log

# Office temporary files
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls
~$*.pptx
~$*.ppt

# Compiled Python / general
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled binaries (DO NOT UPLOAD MALWARE!)
*.exe
*.dll
*.sys
*.bin
*.scr
*.com

# Packed archives
*.7z
*.zip
*.rar
*.tar
*.gz

# Virtual machine files (prevent uploading massive VM files)
*.vmdk
*.vmem
*.vmss
*.vmsn
*.vmsd
*.nvram
*.vswp
*.vmxf
*.log
*.hdd
*.ovf

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Linux specific
.directory
*.part

# Sensitive files (DO NOT UPLOAD passwords or private keys)
*.pem
*.key
*.crt
*.ppk
id_rsa
id_dsa
*.pcap
*.pcapng

# Analysis environment files (if you have any)
*.ova
*.ovf
*.iso
